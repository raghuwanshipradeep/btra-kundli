ASTRO_API_BASE_URL=https://json.astrologyapi.com/v1
ASTRO_API_KEY=your-api-key-here
ASTRO_API_TIMEOUT=30
ASTRO_API_MAX_RETRIES=3
DEFAULT_LANG=hi
LOG_LEVEL=INFO
ANTHROPIC_API_KEY=your-anthropic-key-here

# Phase 6: Commercial polish (all optional)
AUTHOR_NAME=Bloomx Solutions Pvt Ltd
AUTHOR_TITLE=Astrologer 
CTA_CONSULT_URL=https://bloomxsolutions.com/
CTA_POOJA_URL=https://bloomxsolutions.com/
BRAND_FOOTER_ENABLED=true
BRAND_FOOTER_NAME=https://bloomxsolutions.com/
BRAND_FOOTER_URL=https://bloomxsolutions.com/
BRAND_FOOTER_PHONE=+91-8839523452

# Razorpay payment integration
# Get test keys: Razorpay Dashboard → Settings → API Keys → Generate Test Key
# Test card: 4111 1111 1111 1111, any future expiry (e.g. 12/30), any CVV (e.g. 123)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
# Webhook secret — set the SAME value here and in Razorpay Dashboard → Settings → Webhooks.
# Enables the server-side /razorpay-webhook fulfillment path (reliable even if the
# browser callback never fires). Active event: payment.captured
RAZORPAY_WEBHOOK_SECRET=
KUNDLI_PRICE_PAISE=9900
PAYMENT_CURRENCY=INR
ALLOW_FREE_GENERATION=false
# true  = paid form flow generates the PDF inline at payment time (default).
# false = form flow only records + notifies; the sheet_orders DB worker generates the PDF
#         (avoids double-generation when the order also lands in sheet_orders).
INLINE_GENERATION_ENABLED=true

# Google Drive archive
GOOGLE_DRIVE_FOLDER_ID=1M-zfXALz-kKzqU36GHfT3IkgoU3CkYGp
# Amount-based routing (sheet_orders): orders with order_total_amount ABOVE
# DRIVE_PREMIUM_AMOUNT_THRESHOLD archive to this premium folder; the rest (incl. the
# threshold value, lower amounts, null) go to GOOGLE_DRIVE_FOLDER_ID. Leave empty to disable.
GOOGLE_DRIVE_FOLDER_ID_PREMIUM=
DRIVE_PREMIUM_AMOUNT_THRESHOLD=499
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json
DRIVE_ARCHIVE_ENABLED=true
# Per-attempt socket timeout (seconds) for each Drive upload (default 180).
DRIVE_UPLOAD_TIMEOUT_SECONDS=180
# Dir where a paid PDF is saved if the Drive upload ultimately fails, so it
# can be recovered manually. Empty = disabled. Point at a persistent volume.
DRIVE_RECOVERY_DIR=recovery

# Background generation
GENERATION_TIMEOUT_SECONDS=600
# Max kundli PDFs rendered at once. Bursts of simultaneous paid orders queue on
# this cap so they can't starve the API pool or OOM the box (5 => ~2.5 GB peak).
GENERATION_CONCURRENCY=5

# Admin endpoint
ADMIN_KEY=admin-secret-key

# Pabbly Connect webhook — POSTed a payment-success payload for downstream
# automation (WhatsApp confirmation, CRM/sheet logging). Empty = disabled.
PABBLY_WEBHOOK_URL=

# Supabase order/payment tracking (best-effort audit layer; never blocks payment).
# Disabled unless BOTH URL and service_role key are set.
# SUPABASE_SERVICE_KEY is the service_role secret — SERVER-SIDE ONLY. It bypasses
# Row Level Security; never put it in the frontend or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=kundli_orders

# Sheet-driven kundli generation. The sweeper reads SUCCESSFUL rows from this table
# (fed by the hourly Apps Script sync), generates each PDF, and archives it to Drive.
SHEET_ORDERS_TABLE=sheet_orders
SHEET_ORDERS_KUNDLI_MAX_ATTEMPTS=3

# Standalone sweeper process (run: python run_sweeper.py — ONE instance, never replicas).
# SHEET_SWEEPER_ENABLED=false idles the loop without a restart. The interval is the poll
# cadence between drains. The manual endpoint POST /admin/process-sheet-orders is unaffected.
SHEET_SWEEPER_ENABLED=true
SHEET_SWEEP_INTERVAL_SECONDS=60
